{
  "name": "almagest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/almagest.html')\"",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
